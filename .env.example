# Neon (dashboard reads)
DATABASE_URL=

# GitHub Actions dispatch (server-only — never NEXT_PUBLIC_)
# Fine-grained or classic PAT with actions:write on dmcockerill37/bet-model
GITHUB_PAT=
GITHUB_REPO=dmcockerill37/bet-model

# Enables Actions menu + gates /api/run-action and /api/run-status
# (API callers must send header: x-run-secret: <value>)
RUN_MODEL_SECRET=
